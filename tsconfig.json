{
  "files": ["src/index.d.ts"],
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "build"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "forceConsistentCasingInFileNames": true,
    "outDir": "./build"
  }
}
